SERVICE_NAME=notification
APP_TIMEZONE=europe/kyiv

HTTP_ADDR=:5050
HTTP_SHUTDOWN_TIMEOUT=30s

POSTGRES_HOST=notification-postgres
POSTGRES_PORT=5432
POSTGRES_USER=notification
POSTGRES_PASSWORD=secret
POSTGRES_DB=notification_db
POSTGRES_SSLMODE=disable
POSTGRES_CONN_TIMEOUT=3s
POSTGRES_OP_TIMEOUT=5s
POSTGRES_TX_TIMEOUT=15s
POSTGRES_FOLDER=./out/pgdata
POSTGRES_CONTAINER=notification-postgres
POSTGRES_TIMEOUT=10s

LOGGER_LEVEL=DEBUG
LOGGER_FOLDER=out/log

NATS_URL=nats:4222
NATS_SUBJECT=sms.send
NATS_QUEUE=notification-groups
NATS_NAME=notification-service

NATS_CONTAINER=nats
NATS_FOLDER=/out/natsdata

PORT_FORWARDER=port-forwarder
MIGRATION_FOLDER=/migrations
MIGRATION_CONTAINER=migrate

APP_SMS_TEXT=
APP_API_KEY=